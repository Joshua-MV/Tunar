{
  "expo": {
    "name": "Tunar",
    "slug": "tunar",
    "scheme": "rifflytuner",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1E1F1B",
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Tunar uses the microphone to hear your instrument while tuning. Audio is analysed on your device and never recorded or uploaded."
        }
      ]
    ],
    "experiments": { "typedRoutes": false }
  }
}
