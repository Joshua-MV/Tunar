{
  "name": "tunar",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "private": true,
  "description": "Tunar: Guitar, Bass & Ukulele, for Windows. Run `npm.cmd run build` for the Store installer.",
  "scripts": {
    "build": "node build.mjs build",
